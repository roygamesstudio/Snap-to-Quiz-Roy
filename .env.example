# Snap-to-Quiz Environment Variables
# Copy this file to ".env" and fill in your keys.

# Google Gemini API Key (required for AI quiz generation)
# Get yours at https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=
# Optional: override the default vision-capable model if your key exposes a different model.
VITE_GEMINI_MODEL=gemini-3.6-flash

# Supabase Project URL and Anon Key (required for auth + cloud sync)
# Get yours at https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Paystack Public Key (required for payments; use pk_test_* or pk_live_* from Paystack)
# Get yours at https://dashboard.paystack.com/#/settings/developer
VITE_PAYSTACK_PUBLIC_KEY=

# Tier limits (change these centrally without editing application code).
VITE_FREE_DAILY_SCANS=5
VITE_FREE_DAILY_AD_BONUSES=5
VITE_PRO_MONTHLY_SCANS=300
VITE_SUPPORT_EMAIL=orbit3xadmin@gmail.com

# Adsterra zone and the script URL copied from the Adsterra dashboard (optional).
# Use {ZONE_ID} in the script URL when the dashboard URL contains the zone ID.
VITE_ADSTERRA_KEY=
VITE_ADSTERRA_ZONE_ID=test_zone_id_placeholder
VITE_ADSTERRA_SCRIPT_URL=
VITE_ADSENSE_KEY=

# Supabase Edge Function secrets, configured with `supabase secrets set`.
# Never expose these as VITE_ variables in the browser.
# PAYSTACK_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPPORT_EMAIL=orbit3xadmin@gmail.com
# RESEND_API_KEY=
# FEEDBACK_FROM_EMAIL=Snap-to-Quiz <feedback@your-verified-domain.example>
VITE_APPLIXIR_API_KEY=your_applixir_api_key_here