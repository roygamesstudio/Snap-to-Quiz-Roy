# PhotoQuizzer Environment Variables
# Copy this file to ".env" and fill in your keys.

# Google Gemini API Key (required for AI quiz generation)
EXPO_PUBLIC_GEMINI_API_KEY=

# Supabase Project URL and Anon Key (required for auth + cloud sync)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# AppLovin MAX SDK Key and Ad Unit IDs
EXPO_PUBLIC_APPLOVIN_SDK_KEY=
EXPO_PUBLIC_APPLOVIN_REWARDED_AD_UNIT_ID=
EXPO_PUBLIC_APPLOVIN_INTERSTITIAL_AD_UNIT_ID=
EXPO_PUBLIC_APPLOVIN_BANNER_AD_UNIT_ID=
